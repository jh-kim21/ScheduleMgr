' ProjectFlow launcher (no console window). Double-click this file.
' Comments are ASCII on purpose: .vbs is read with the system ANSI codepage, so
' non-ASCII text here can render as garbage on a non-Korean Windows.
Set fso = CreateObject("Scripting.FileSystemObject")
Set sh = CreateObject("WScript.Shell")
base = fso.GetParentFolderName(WScript.ScriptFullName)
sh.CurrentDirectory = base
cmd = """" & base & "\runtime\bin\javaw.exe"" -XX:MaxRAMPercentage=70 -Dspring.profiles.active=desktop -Dproject-flow.desktop.enabled=true -Djava.awt.headless=false -jar """ & base & "\app\@MAIN_JAR@"""
sh.Run cmd, 0, False
